<UserControl x:Class="DarkLedger.WPF.Views.ReportsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOOLBAR ==================== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="📋 Копировать" Style="{StaticResource DarkButton}"
                    Width="140" Margin="0,0,8,0" Click="CopyToClipboard_Click"/>
            <Button Content="💾 TXT" Style="{StaticResource DarkButton}"
                    Width="80" Margin="0,0,8,0" Click="SaveTxt_Click"/>
            <Button Content="📊 CSV" Style="{StaticResource DarkButton}"
                    Width="80" Margin="0,0,8,0" Click="SaveCsv_Click"/>
            <Button Content="📁 Папка" Style="{StaticResource DarkButton}"
                    Width="100" Margin="0,0,8,0" Click="OpenFolder_Click"/>
            <Button Content="🗑 Удалить" Style="{StaticResource DarkButton}"
                    Width="110" Margin="0,0,8,0" Click="DeleteAll_Click"/>
            <Button Content="📦 Экспорт ZIP" Style="{StaticResource PurpleButton}"
                    Width="150" Click="ExportAllData_Click"/>
        </StackPanel>

        <!-- ==================== ПЕРИОДЫ ==================== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RepFilterToday" Content="Сегодня" GroupName="RepPeriod"
                         Style="{StaticResource FilterButton}" IsChecked="True"
                         Margin="0,0,8,0" Click="Period_Click" Tag="Today"/>
            <RadioButton x:Name="RepFilterYesterday" Content="Вчера" GroupName="RepPeriod"
                         Style="{StaticResource FilterButton}"
                         Margin="0,0,8,0" Click="Period_Click" Tag="Yesterday"/>
            <RadioButton x:Name="RepFilter7Days" Content="7 дней" GroupName="RepPeriod"
                         Style="{StaticResource FilterButton}"
                         Margin="0,0,8,0" Click="Period_Click" Tag="Last7Days"/>
            <RadioButton x:Name="RepFilter30Days" Content="30 дней" GroupName="RepPeriod"
                         Style="{StaticResource FilterButton}"
                         Margin="0,0,8,0" Click="Period_Click" Tag="Last30Days"/>
            <RadioButton x:Name="RepFilterAllTime" Content="Всё время" GroupName="RepPeriod"
                         Style="{StaticResource FilterButton}"
                         Click="Period_Click" Tag="AllTime"/>
        </StackPanel>

        <!-- ==================== ОТЧЁТ ==================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="ReportScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="12">
                <TextBlock x:Name="ReportText"
                           FontFamily="{StaticResource FontFamilyMono}"
                           FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

        <!-- ==================== СТАТУС ==================== -->
        <TextBlock Grid.Row="3"
                   x:Name="StatusText"
                   Text=""
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="{StaticResource FontSizeSmall}"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>