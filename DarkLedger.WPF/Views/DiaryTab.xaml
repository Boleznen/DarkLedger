<UserControl x:Class="DarkLedger.WPF.Views.DiaryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== ЛЕВАЯ ПАНЕЛЬ ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BackgroundPanelBrush}"
                CornerRadius="8"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="240"/>
                    <!-- Календарь -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кнопки -->
                    <RowDefinition Height="Auto"/>
                    <!-- Поиск -->
                    <RowDefinition Height="*"/>
                    <!-- Список дней -->
                </Grid.RowDefinitions>

                <!-- Календарь -->
                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="6"
                        Margin="0,0,0,8">
                    <Grid x:Name="CalendarHost"/>
                </Border>

                <!-- Кнопки -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            x:Name="TodayButton"
                            Content="📍 Сегодня"
                            Style="{StaticResource AccentButton}"
                            Height="30"
                            Click="TodayButton_Click"/>
                    <Button Grid.Column="2"
                            x:Name="HideEmptyButton"
                            Content="👁 Скрыть пустые"
                            Style="{StaticResource DarkButton}"
                            Height="30"
                            Click="HideEmptyButton_Click"/>
                </Grid>

                <!-- Поиск -->
                <TextBox Grid.Row="2"
                         x:Name="SearchBox"
                         Height="26"
                         Margin="0,0,0,8"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="🔍 Поиск по заметкам"/>

                <!-- Список дней -->
                <Border Grid.Row="3"
                        Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="6">
                    <ScrollViewer x:Name="DaysScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DaysContainer"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== ПРАВАЯ ПАНЕЛЬ ==================== -->
        <Border Grid.Column="2"
                Background="{StaticResource BackgroundDarkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Заголовок даты -->
                    <RowDefinition Height="*"/>
                    <!-- Заметки -->
                    <RowDefinition Height="Auto"/>
                    <!-- Статус -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           x:Name="DateHeader"
                           Text="—"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        Background="{StaticResource BackgroundCardBrush}"
                        CornerRadius="6"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <TextBox x:Name="NotesBox"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0"
                             Padding="10"
                             FontSize="{StaticResource FontSizeBodyLarge}"
                             FontFamily="{StaticResource FontFamilyMain}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="NotesBox_TextChanged"/>
                </Border>

                <TextBlock Grid.Row="2"
                           x:Name="StatusText"
                           Text=""
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>